<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Links Demo</title>
</head>
<body>
  <p id="top">Links demo</p>
 
  <!-- External link: opens another website -->
  <a href="https://www.google.com" target="_blank">External link</a><br>
 
  <!-- Internal link: jumps to the id="bottom" on this page -->
  <a href="#bottom">Jump to bottom</a><br>
 
  <!-- Email link -->
  <a href="mailto:info@college.edu">Email us</a><br>
 
  <!-- Image (the picture shows a broken icon if logo.png is not in your folder) -->
  <img src="logo.png" alt="Logo" width="120" height="60">
 
  <!-- Empty space to make the page long -->
  <div style="height: 300px;"></div>
 
  <p id="bottom">Bottom. <a href="#top">Back to top</a></p>
</body>
</html>