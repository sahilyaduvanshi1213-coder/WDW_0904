<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ABC College Admission</title>
  <style>
    body { margin: 0; }
    header, footer {
       background-color: #1a237e;  /* dark blue */
       color: white;
       text-align: center;
    }
    header { padding: 25px 0; }
    footer { padding: 10px 0; }
    footer p { margin: 0; }
    main { max-width: 560px; margin: 0 auto; }   /* centre the content */
    table { border-collapse: collapse; width: 100%; margin-bottom: 15px; }
    th, td { border: 1px solid #999999; padding: 6px; text-align: left; }
    th { background-color: #e8eaf6; text-align: center; }
    .skip { position: absolute; left: -999px; } /* hidden until you press Tab */
    .skip:focus { left: 5px; top: 5px; background: yellow; }
  </style>
</head>
<body>
  <!-- Skip link for keyboard users -->
  <a href="#form" class="skip">Skip to form</a>

  <header>
    <h1>ABC College Admission 2026</h1>
  </header>

  <main>
    <h2>Courses and Fees</h2>

    <table>
      <caption>Available Courses</caption>
      <thead>
        <tr>
          <th>Course</th>
          <th>Seats</th>
          <th>Fees</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>B.Tech CSE</td>
          <td>120</td>
          <td>&#8377;90,000</td>
        </tr>
        <tr>
          <td>BCA</td>
          <td>60</td>
          <td>&#8377;45,000</td>
        </tr>
      </tbody>
    </table>

    <form id="form" action="submit.php" method="post">
      <fieldset>
        <legend>Application Form</legend>

        <p>
          <label for="name">Name:</label><br>
          <input type="text" id="name" name="name" required>
        </p>

        <p>
          <label for="email">Email:</label><br>
          <input type="email" id="email" name="email" required>
        </p>

        <p>
          <label for="course">Course:</label><br>
          <select id="course" name="course">
            <option>B.Tech CSE</option>
            <option>BCA</option>
          </select>
        </p>

        <p>
          <label for="statement">Statement:</label><br>
          <textarea id="statement" name="statement" rows="4" cols="50"></textarea>
        </p>

        <button type="submit">Apply</button>
      </fieldset>
    </form>
  </main>

  <footer>
    <p>&copy; 2026 ABC College</p>
  </footer>
</body>
</html>