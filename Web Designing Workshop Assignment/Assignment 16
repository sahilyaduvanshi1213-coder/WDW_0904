<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Select and Textarea</title>
</head>
<body>
  <form>
    <p>
      <label for="course">Course:</label>
      <select id="course">
        <option>ECE</option>
        <option>CSE</option>
        <option>ME</option>
      </select>
    </p>
 
    <p>
      <label for="fb">Feedback:</label><br>
      <textarea id="fb" rows="5" cols="45" placeholder="Write here..."></textarea>
    </p>
 
    <p>
      <button type="submit">Submit</button>
      <button type="reset">Reset</button>
      <button type="button">Click Me</button>
    </p>
  </form>
</body>
</html>