<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Block and Inline</title>
  <style>
    div { background-color: lightblue; margin: 5px; }
    span { background-color: lightgreen; }
  </style>
</head>
<body>
  <!-- div is a BLOCK element: each one takes a full line -->
  <div>Block 1</div>
  <div>Block 2</div>
 
  <!-- span is an INLINE element: they sit side by side -->
  <span>Inline 1</span>
  <span>Inline 2</span>
  <span>Inline 3</span>
</body>
</html>
        
   