<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Lab Schedule</title>
  <style>
    table {
      border-collapse: collapse;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 16px;
    }
    th, td {
      border: 1px solid #555;
      padding: 10px 14px;
      text-align: left;
    }
    th {
      text-align: center;
      font-weight: bold;
    }
    /* Styling for the nested table */
    .nested-table {
      margin: 2px auto;
    }
    .nested-table th, .nested-table td {
      padding: 8px 12px;
      text-align: left;
    }
  </style>
</head>
<body>

  <table>
    <thead>
      <tr>
        <th>Day</th>
        <th>Lab Batches</th>
        <th>Faculty</th>
        <th>Room</th>
        <th>Time</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Friday</td>
        <td>
          <!-- Nested Table -->
          <table class="nested-table">
            <thead>
              <tr>
                <th>Batch</th>
                <th>System</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>A1</td>
                <td>PC 1-20</td>
              </tr>
              <tr>
                <td>A2</td>
                <td>PC 21-40</td>
              </tr>
            </tbody>
          </table>
        </td>
        <td>Dr. Sharma</td>
        <td>Lab 2</td>
        <td>2-4 PM</td>
      </tr>
    </tbody>
  </table>

</body>
</html>